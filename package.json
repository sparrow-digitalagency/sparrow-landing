{
  "name": "sparrow-landing",
  "version": "0.1.0",
  "private": true,
  "description": "Sparrow.Agency advertising landing page (UA / EN / PL / RU). Separate from the corporate website.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:messages": "node scripts/check-messages.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm check:messages && pnpm format:check"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
