# Copy to .env.local for local development. Never commit real values.

# Public base URL of the landing (used for canonical, hreflang, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search indexing is disabled unless explicitly set to "true" (enable only on production launch).
NEXT_PUBLIC_ALLOW_INDEXING=false

